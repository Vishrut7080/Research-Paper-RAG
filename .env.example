# LLM (Groq) — used by rag.ipynb and backend/rag/generator.py
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Web search (Tavily) — used as fallback when retrieval confidence is low
TAVILY_API_KEY=your_tavily_api_key

# Optional: override where the corpus lives (default: ./research_papers)
# RESEARCH_CORPUS=/absolute/path/to/papers

# Frontend (frontend/.env) — where the React dev server talks to
VITE_API_URL=http://localhost:8000